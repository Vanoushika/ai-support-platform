{
  "uid": "support-platform",
  "title": "AI Support Platform",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "description": "Includes UI polling and API calls; excludes /health. Route labels are templates.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(support_http_requests_total[1m]))",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "API 5xx error rate",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(support_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(support_http_requests_total[1m])), 0.000001) or vector(0)",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "description": "Approximate histogram percentile; very small samples are not a performance benchmark.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(support_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Average operation duration",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(support_operation_duration_seconds_sum[5m])) / sum by (operation) (rate(support_operation_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Operation executions in last 15 minutes",
      "description": "Execution attempts, not unique tickets. Retries may be counted. Errors mean raised exceptions, not model-quality failures.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (increase(support_operations_total[15m]))",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Collector scrape health",
      "description": "1 = Prometheus can scrape the collector. This does not prove trace export is working.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "support-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"support-otel\"}",
          "legendFormat": "{{route}}{{operation}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Inspect distributed traces",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Open **Explore \u2192 Tempo**, choose **TraceQL**, and run `{ resource.service.name = \"support-worker\" }`. Set the time range to **Last 15 minutes**. Open a trace to see Temporal spans and `review.prepare`, `ticket.classify`, `knowledge.search`, and `draft.generate`.\n\nOld workflows do not gain historical traces. Create a new ticket after enabling telemetry. A successful HTTP request or operation does not prove the AI draft is correct."
      }
    }
  ]
}